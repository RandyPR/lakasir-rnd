# Laravel Herd (Windows) variant of .env.example. One shop per deployment, no Docker/Redis.
# Usage: copy to .env  (see README, section 'Local development with Laravel Herd').
# Requires PHP 8.4 (composer.json). Database is SQLite at database/database.sqlite: create the empty file first (README). Switch back to MySQL by restoring the commented DB_* lines.
APP_NAME=Lakasir
APP_ENV=local
APP_LOCAL=en
APP_KEY=
APP_DEBUG=true
APP_URL=http://lakasir-rnd.test
FORWARD_REDIS_PORT=6381
FORWARD_DB_PORT=3307

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=lakasir
#DB_USERNAME=root
#DB_PASSWORD=
DB_DATABASE_TESTING=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
UPLOAD_DISK=public
TMP_DISK=tmp
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
FIREBASE_CREDENTIALS=

SELLING_METHOD=normal

SPA_MODE=false
DARK_MODE=false

WWWUSER=1000
WWWGROUP=1000